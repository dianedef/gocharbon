---
import ThemeToggle from "./ThemeToggle.astro";
import { Home, ChevronRight } from "@lucide/astro";
import { SITE } from "../../config/site";
import { ROUTES } from "../../config/routes";
import { isParcoursOnlyBuild } from "../../utils/build-scope";
import { getResolvedBreadcrumbs } from "../../utils/internal-links";
import type {
	BaseNavigationProps,
	NavigationItem,
	SocialLink,
} from "../../utils/types/ui";

type Props = BaseNavigationProps;

const launchBuild = isParcoursOnlyBuild();
const navigationItems: NavigationItem[] = launchBuild
	? [{ name: "Parcours", url: ROUTES.parcours }]
	: [
		{ name: "Parcours", url: ROUTES.parcours },
		{ name: "Outils", url: ROUTES.outils },
		{ name: "Blog", url: ROUTES.blog },
		{ name: "Tutos", url: ROUTES.tutos },
		{ name: "Progression", url: ROUTES.progression },
	];

const socialIcons: SocialLink[] = [
	{
		name: "YouTube",
		url: SITE.social.youtube,
		icon: "i-uil-youtube",
	},
	{
		name: "Twitter",
		url: SITE.social.x,
		icon: "i-uil-twitter",
	},
	{
		name: "Instagram",
		url: SITE.social.instagram,
		icon: "i-uil-instagram",
	},
	{
		name: "LinkedIn",
		url: SITE.social.linkedin,
		icon: "i-uil-linkedin",
	},
	{
		name: "Facebook",
		url: SITE.social.facebook,
		icon: "i-uil-facebook",
	},
];

if (!launchBuild) {
	socialIcons.push({ name: "RSS", url: ROUTES.feed, icon: "i-uil-rss" });
}

const { pageTitle } = Astro.props;
const worldIcons = {
	charbon: "/images/icons/pixel-mine-v1/coal-v1.png",
	mine: "/images/icons/pixel-mine-v1/crossed-pickaxes-v1.png",
	or: "/images/icons/pixel-mine-v1/gold-v1.png",
};

const breadcrumbLabels: Record<string, string> = {
	tech: "Technologie",
	business: "Business",
	outils: "Outils",
	methodologie: "Methodologie",
	tutos: "Tutoriels",
	parcours: "Parcours",
	ia: "Intelligence Artificielle",
	saas: "SaaS",
	marketing: "Marketing",
};

const breadcrumbs = getResolvedBreadcrumbs(Astro.url.pathname, breadcrumbLabels);
const isLanding = Astro.url.pathname === "/";
const worldTabs = [
	{ key: "charbon", label: "Charbon", icon: worldIcons.charbon },
	{ key: "mine", label: "Mine", icon: worldIcons.mine },
	{ key: "or", label: "Or", icon: worldIcons.or },
];
---

<style define:vars={{ softWhite: 'var(--brand-cream)' }}>
	header {
		border-bottom: 4px solid var(--brand-black);
		background-color: var(--brand-cream);
		position: sticky;
		top: 0;
		z-index: 40;
	}

	:global(.dark) header {
		border-color: var(--softWhite);
		background-color: var(--brand-ink);
		color: var(--softWhite);
	}

	.mobile-link {
		color: var(--brand-black);
	}

	:global(.dark) .mobile-link {
		color: var(--softWhite);
	}

	.breadcrumbs {
		display: flex;
		align-items: center;
		gap: var(--gc-primitive-space-2);
		font-size: 0.9rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.breadcrumb-item {
		display: flex;
		align-items: center;
		gap: var(--gc-primitive-space-2);
	}

	.breadcrumb-link {
		display: flex;
		align-items: center;
		color: inherit;
		text-decoration: none;
	}

	.breadcrumb-link:hover {
		color: var(--accent-color);
		text-decoration: underline;
	}

	.world-cues {
		margin-left: 0.35rem;
	}

	.landing-navigation {
		display: grid;
		grid-template-columns: auto auto 1fr auto;
		align-items: stretch;
		min-height: var(--gc-surface-web-landing-navigation-height);
		border: var(--gc-component-pixel-frame-border-width) solid color-mix(in srgb, var(--gc-surface-web-landing-chrome-text) 12%, transparent);
		background: var(--gc-surface-web-landing-chrome-background);
		box-shadow: var(--gc-component-pixel-frame-shadow);
	}

	.landing-logo {
		display: flex;
		align-items: center;
		padding-inline: var(--gc-primitive-space-6);
		border-right: var(--gc-component-pixel-frame-edge-unit) solid color-mix(in srgb, var(--gc-surface-web-landing-chrome-text) 12%, transparent);
		color: var(--gc-surface-web-landing-chrome-text);
		text-decoration: none;
	}

	.landing-world-tabs,
	.landing-primary-links {
		display: flex;
		align-items: stretch;
	}

	.landing-world-tab {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: var(--gc-primitive-space-3);
		min-width: var(--gc-surface-web-landing-world-tab-minimum);
		padding-inline: var(--gc-primitive-space-4);
		border-right: var(--gc-component-pixel-frame-edge-unit) solid color-mix(in srgb, var(--gc-surface-web-landing-chrome-text) 12%, transparent);
		color: color-mix(in srgb, var(--gc-surface-web-landing-chrome-text) 68%, transparent);
		font-family: var(--gc-semantic-type-action-family);
		font-size: var(--gc-primitive-font-size-caption);
		font-weight: var(--gc-primitive-font-weight-bold);
		letter-spacing: var(--gc-primitive-font-letter-spacing-wide);
		text-decoration: none;
		text-transform: uppercase;
	}

	.landing-world-tab img {
		width: var(--gc-primitive-size-icon-medium);
		height: var(--gc-primitive-size-icon-medium);
		image-rendering: pixelated;
	}

	.landing-world-tab.is-active {
		background: color-mix(in srgb, var(--gc-semantic-color-mineral-value) 7%, var(--gc-surface-web-landing-panel-background));
		box-shadow: inset 0 calc(var(--gc-component-pixel-frame-edge-unit) * -1) 0 var(--gc-semantic-color-mineral-value);
		color: var(--gc-surface-web-landing-chrome-text);
	}

	.landing-primary-links {
		justify-content: flex-end;
		gap: var(--gc-primitive-space-8);
		padding-inline: var(--gc-primitive-space-6);
	}

	.landing-primary-links a {
		display: flex;
		align-items: center;
		color: color-mix(in srgb, var(--gc-surface-web-landing-chrome-text) 72%, transparent);
		font-size: var(--gc-primitive-font-size-caption);
		font-weight: var(--gc-primitive-font-weight-medium);
		text-decoration: none;
	}

	.landing-primary-links a:hover,
	.landing-world-tab:hover {
		color: var(--gc-semantic-color-mineral-value);
	}

	.landing-account {
		display: flex;
		align-items: center;
		gap: var(--gc-primitive-space-3);
		margin: var(--gc-primitive-space-2);
		padding-inline: var(--gc-primitive-space-4);
		border: var(--gc-component-pixel-frame-border-width) solid color-mix(in srgb, var(--gc-surface-web-landing-chrome-text) 55%, transparent);
		color: var(--gc-surface-web-landing-chrome-text);
		font-family: var(--gc-semantic-type-action-family);
		text-decoration: none;
	}

	.landing-account span:last-child {
		color: var(--gc-semantic-color-mineral-value);
	}

	@media (width < 1180px) {
		.landing-primary-links {
			gap: var(--gc-primitive-space-4);
			padding-inline: var(--gc-primitive-space-4);
		}

		.landing-world-tab {
			min-width: auto;
		}
	}

	@media (width <= 767px) {
		.world-cues {
			display: none;
		}
	}
</style>

{isLanding && (
	<header class="landing-header hidden md:block px-4 py-3">
		{pageTitle && <h1 class="hidden">{pageTitle}</h1>}
		<div class="landing-navigation">
			<a class="landing-logo" href="/" aria-label="Retour à l'accueil">
				<span class="righteous text-3xl">{SITE.nameUpper}</span>
			</a>
			<div class="landing-world-tabs" role="list" aria-label="Mondes GoCharbon">
				{worldTabs.map((tab) => (
					<span class:list={["landing-world-tab", tab.key === "mine" && "is-active"]} role="listitem">
						<img src={tab.icon} alt="" aria-hidden="true" />
						{tab.label}
					</span>
				))}
			</div>
			<nav class="landing-primary-links" aria-label="Navigation principale">
				{navigationItems.map((item) => <a href={item.url}>{item.name}</a>)}
			</nav>
			<a class="landing-account" href={ROUTES.progression}>
				<span>Mon espace</span><span aria-hidden="true">›</span>
			</a>
		</div>
	</header>
)}

<header class:list={["flex flex-col px-4 py-3 md:px-6 md:py-4", isLanding && "md:hidden"]}>
	<div class="flex justify-between items-center">
		{pageTitle && <h1 class="hidden">{pageTitle}</h1>}
		<div class="flex items-center gap-4">
			<a
				href="/"
				title="Retour à l'accueil"
				aria-label="Retour à l'accueil"
				class="inline-block cursor-pointer z-10 relative"
			>
				<span class="righteous text-3xl md:text-5xl text-black dark:text-yellow-soft">{SITE.nameUpper}</span>
			</a>
			<nav aria-label="Fil d'Ariane">
				<ol class="breadcrumbs">
					<li>
						<a href="/" class="breadcrumb-link" aria-label="Accueil">
							<Home class="w-5 h-5" />
						</a>
					</li>
					{
						breadcrumbs.map((crumb) => (
							<li class="breadcrumb-item">
								<ChevronRight class="w-4 h-4" aria-hidden="true" />
								{crumb.isCurrent ? (
									<span aria-current="page">{crumb.label}</span>
								) : (
									<a href={crumb.href} class="breadcrumb-link">
										{crumb.label}
									</a>
								)}
							</li>
						))
					}
				</ol>
			</nav>
				<div class="mine-icon-belt world-cues" aria-label="Repères du monde GoCharbon">
					<span class="mine-icon-chip">
						<img src={worldIcons.charbon} alt="" aria-hidden="true" loading="lazy" />
						Charbon
					</span>
					<span class="mine-icon-chip mine">
						<img src={worldIcons.mine} alt="" aria-hidden="true" loading="lazy" />
						Mine
					</span>
					<span class="mine-icon-chip or">
						<img src={worldIcons.or} alt="" aria-hidden="true" loading="lazy" />
						Or
					</span>
				</div>
		</div>
		<nav class="hidden md:inline-block">
			<h2 class="hidden">Navigation</h2>
			<ul class="flex gap-6 poppins items-center">
					{
						navigationItems.map((item) => (
							<li>
								<a
									class="text-lg font-medium hover:underline transition-all duration-150 ease-in-out"
									href={item.url}
									title={`Go to ${item.name}`}
								>
									{item.name}
								</a>
							</li>
					))
				}
				{
					socialIcons.map((item) => (
						<li>
							<a
								href={item.url}
								target="_blank"
								title={`Voir ${SITE.name} sur ${item.name}`}
							>
								<div
									class:list={[item.icon, "w-6 h-6 md:w-7 md:h-7"]}
								/>
							</a>
						</li>
					))
				}
				<li>
					<ThemeToggle />
				</li>
			</ul>
		</nav>
		<nav class="md:hidden flex items-center gap-3">
			<h2 class="hidden">Mobile Navigation</h2>
			<ThemeToggle />
			<button
				id="mobile-menu-btn"
				class="gc-control gc-control--icon"
				aria-label="Ouvrir le menu"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path id="hamburger-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
					<path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</nav>
	</div>
	<!-- Mobile menu panel -->
	<div id="mobile-menu" class="md:hidden hidden border-t-2 border-black dark:border-yellow-soft px-4 py-4">
		<div class="mine-icon-belt mb-4" aria-label="Repères du monde GoCharbon">
			<span class="mine-icon-chip">
				<img src={worldIcons.charbon} alt="" aria-hidden="true" loading="lazy" />
				Charbon
			</span>
			<span class="mine-icon-chip mine">
				<img src={worldIcons.mine} alt="" aria-hidden="true" loading="lazy" />
				Mine
			</span>
			<span class="mine-icon-chip or">
				<img src={worldIcons.or} alt="" aria-hidden="true" loading="lazy" />
				Or
			</span>
		</div>
		<ul class="flex flex-col gap-4 poppins">
			{
				navigationItems.map((item) => (
					<li>
						<a
							class="mobile-link text-lg font-medium block py-2"
							href={item.url}
						>
							{item.name}
						</a>
					</li>
				))
			}
		</ul>
		<div class="border-t border-black/20 dark:border-white/20 my-3"></div>
		<ul class="flex flex-wrap gap-4">
			{
				socialIcons.map((item) => (
					<li>
						<a
							href={item.url}
							target="_blank"
							rel="noopener noreferrer"
							title={`Voir ${SITE.name} sur ${item.name}`}
							class="mobile-link"
						>
							<div class:list={[item.icon, "w-7 h-7"]} />
						</a>
					</li>
				))
			}
		</ul>
	</div>
</header>

<script>
	const initMobileMenu = () => {
		const btn = document.getElementById("mobile-menu-btn");
		const menu = document.getElementById("mobile-menu");
		const hamburgerIcon = document.getElementById("hamburger-icon");
		const closeIcon = document.getElementById("close-icon");
		const mobileLinks = menu?.querySelectorAll('a[href^="/"]');

		if (!btn || !menu || btn.dataset.mobileMenuInit === "true") return;
		btn.dataset.mobileMenuInit = "true";

		btn.addEventListener("click", () => {
			const isOpen = menu.classList.toggle("hidden") === false;
			btn.setAttribute("aria-expanded", String(isOpen));
			btn.setAttribute("aria-label", isOpen ? "Fermer le menu" : "Ouvrir le menu");
			hamburgerIcon?.classList.toggle("hidden", isOpen);
			closeIcon?.classList.toggle("hidden", !isOpen);
		});

		mobileLinks?.forEach((link) => {
			link.addEventListener("click", () => {
				menu.classList.add("hidden");
				btn.setAttribute("aria-expanded", "false");
				btn.setAttribute("aria-label", "Ouvrir le menu");
				hamburgerIcon?.classList.remove("hidden");
				closeIcon?.classList.add("hidden");
			});
		});
	};

	initMobileMenu();
	document.addEventListener("astro:page-load", initMobileMenu);
	document.addEventListener("astro:after-swap", initMobileMenu);
	document.addEventListener("DOMContentLoaded", initMobileMenu);
</script>
