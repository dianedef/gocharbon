---
import Button from "./Button.astro";
---

<section class="flex flex-col gap-8 justify-between">
	<p class="text-9xl font-bold dm-serif dark:text-white">404</p>
	<h2 class="text-4xl outfit dark:text-white">Page non trouvée</h2>
	<p class="text-xl sm:text-3xl sanchez dark:text-yellow-soft">
		Désolé, nous n'avons pas trouvé la page que vous cherchez.
	</p>
	<Button href="/" variant="secondary">&larr; Accueil</Button>
</section>
