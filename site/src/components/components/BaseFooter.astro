---
import { SITE } from "../../config/site";
import { ROUTES } from "../../config/routes";
import { isParcoursOnlyBuild } from "../../utils/build-scope";
import ThemeToggle from "./ThemeToggle.astro";

export interface Props {
	backToTop?: boolean;
}

const { backToTop = false } = Astro.props;

const launchBuild = isParcoursOnlyBuild();
const navigationLinks = launchBuild
	? [{ name: "Parcours", url: ROUTES.parcours }]
	: [
		{ name: "Parcours", url: ROUTES.parcours },
		{ name: "Outils", url: ROUTES.outils },
		{ name: "Méthodologie", url: ROUTES.methodologie },
		{ name: "Blog", url: ROUTES.blog },
		{ name: "Tutos", url: ROUTES.tutos },
		{ name: "Progression", url: ROUTES.progression },
	];

const legalLinks = [
	{ name: "Politique de confidentialité", url: ROUTES.confidentialite },
	{ name: "Mentions légales", url: ROUTES.mentionsLegales },
	{ name: "CGU", url: ROUTES.cgu },
];

const socialLinks = [
	{ name: "YouTube", url: SITE.social.youtube },
	{ name: "X (Twitter)", url: SITE.social.x },
	{ name: "Instagram", url: SITE.social.instagram },
	{ name: "LinkedIn", url: SITE.social.linkedin },
	{ name: "Facebook", url: SITE.social.facebook },
];

const currentYear = new Date().getFullYear();
const worldIcons = {
	charbon: "/world/charbon.svg",
	mine: "/world/mine.svg",
	or: "/world/or.svg",
};
---

{
	backToTop && (
		<button
			class:list={[
				backToTop ? `backToTop` : null,
				"back-to-top-button",
			]}
		>
			<svg
				xmlns="http://www.w3.org/2000/svg"
				fill="none"
				viewBox="0 0 24 24"
				height="24"
				width="24"
				stroke-width="2"
				stroke="currentColor"
				class="back-to-top-icon"
			>
				<path
					stroke-linecap="round"
					stroke-linejoin="round"
					d="m4.5 15.75 7.5-7.5 7.5 7.5"
				/>
			</svg>
		</button>
	)
}

<footer class="pixel-mine-footer">
	<div class="max-w-6xl mx-auto px-6 py-12">
		<!-- Top section -->
		<div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-8">
			<!-- Brand -->
			<div class="col-span-2">
				<h2 class="righteous text-3xl mb-4 footer-heading">{SITE.nameUpper}</h2>
				<p class="poppins text-lg mb-4">
					{SITE.descriptions.footer}
				</p>
				<div class="mine-icon-belt mb-4" aria-label="Repères du monde GoCharbon">
					<span class="mine-icon-chip">
						<img src={worldIcons.charbon} alt="" aria-hidden="true" loading="lazy" />
						Charbon
					</span>
					<span class="mine-icon-chip mine">
						<img src={worldIcons.mine} alt="" aria-hidden="true" loading="lazy" />
						Mine
					</span>
					<span class="mine-icon-chip or">
						<img src={worldIcons.or} alt="" aria-hidden="true" loading="lazy" />
						Or
					</span>
				</div>
				<p class="poppins text-sm">
					🇫🇷 Made in France avec ❤️
				</p>
			</div>

			<!-- Navigation -->
			<div>
				<h3 class="poppins font-bold text-lg mb-4 footer-heading">Navigation</h3>
				<ul class="space-y-2">
					{navigationLinks.map((link) => (
						<li>
							<a
								href={link.url}
								class="poppins footer-link transition-colors duration-200"
							>
								{link.name}
							</a>
						</li>
					))}
				</ul>
			</div>

			<!-- Social -->
			<div>
				<h3 class="poppins font-bold text-lg mb-4 footer-heading">Suivez-nous</h3>
				<ul class="space-y-2">
					{socialLinks.map((link) => (
						<li>
							<a
								href={link.url}
								target="_blank"
								rel="noopener noreferrer"
								class="poppins footer-link transition-colors duration-200"
							>
								{link.name}
							</a>
						</li>
					))}
				</ul>
			</div>
		</div>

		<!-- Divider -->
		<div class="footer-divider my-8"></div>

		<!-- Bottom section -->
		<div class="flex flex-col md:flex-row justify-between items-center gap-4">
			<p class="poppins text-sm">
				© {currentYear} {SITE.copyrightName}. Tous droits réservés.
			</p>
			<ul class="flex flex-wrap gap-4 justify-center">
				{legalLinks.map((link) => (
					<li>
						<a
							href={link.url}
							class="poppins text-sm footer-link transition-colors duration-200"
						>
							{link.name}
						</a>
					</li>
				))}
			</ul>
			<div class="footer-theme-control">
				<span class="poppins text-sm">Thème</span>
				<ThemeToggle />
			</div>
		</div>
	</div>
</footer>

<style>
	.pixel-mine-footer {
		border-top: var(--gc-semantic-shape-pixel-unit) solid var(--gc-semantic-color-mineral-value);
		background: var(--gc-semantic-color-mine-depth);
		color: var(--gc-semantic-color-text);
	}

	.footer-heading,
	.back-to-top-icon {
		color: var(--gc-semantic-color-mineral-value);
	}

	.footer-link {
		color: var(--gc-semantic-color-text);
	}

	.footer-link:hover {
		color: var(--gc-semantic-color-link-hover);
	}

	.footer-link:focus-visible,
	.footer-theme-control :global(button):focus-visible {
		outline: var(--gc-semantic-shape-border-width) solid var(--gc-semantic-color-focus);
		outline-offset: var(--gc-surface-web-hover-offset);
	}

	.footer-divider {
		border-top: var(--gc-primitive-border-thin) solid var(--gc-semantic-color-border);
	}

	.footer-theme-control {
		display: flex;
		align-items: center;
		gap: var(--gc-primitive-space-2);
		padding: var(--gc-primitive-space-1) var(--gc-primitive-space-2);
		border: var(--gc-primitive-border-medium) solid var(--gc-semantic-color-border);
		background: var(--gc-semantic-color-mine-panel);
	}

	.footer-theme-control :global(button) {
		color: var(--gc-semantic-color-mineral-value);
	}

	.backToTop.active {
		opacity: 1;
		cursor: pointer;
	}
	
	.backToTop:hover {
		transform: translateY(-2px);
	}
</style>

<script>
	document.addEventListener("astro:page-load", () => {
		const backToTop = document.querySelector(".backToTop");

		const toggleBackToTopButton = () => {
			if (window.scrollY > 250) {
				backToTop?.classList.add("active");
			} else {
				backToTop?.classList.remove("active");
			}
		};

		backToTop?.addEventListener("click", () => {
			window.scrollTo({
				top: 0,
				behavior: "smooth",
			});
		});

		window.addEventListener("scroll", toggleBackToTopButton);
	});
</script>
