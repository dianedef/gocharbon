---
import type { CardProps } from "../../utils/types/ui";
import colors from "../config/colors.json";

type Props = CardProps;

const {
	color = colors.light[Math.floor(Math.random() * colors.light.length)],
} = Astro.props;
---

<style define:vars={{ color, softWhite: 'var(--brand-cream)' }}>
	.brutal-card-astro {
		background-color: var(--color);
		border-radius: var(--sf-auto-global2-card-border-radius-bd133203);
		border: 3px solid var(--brand-black);
		filter: var(--sf-auto-global2-card-filter-dd6e7d04);
		padding: var(--sf-auto-global2-card-padding-166f12be);
		color: var(--brand-black);
	}

	:global(.dark) .brutal-card-astro {
		background-color: var(--brand-ink);
		border: 3px solid var(--softWhite);
		filter: drop-shadow(7px 7px 0 var(--softWhite));
		color: var(--softWhite);
	}
</style>

<div class="brutal-card-astro">
	<slot />
</div>
