---
import type { EngagementBadge as EngagementBadgeData } from "../../utils/tool-qualification";

interface Props {
  badge: EngagementBadgeData;
  compact?: boolean;
}

const { badge, compact = false } = Astro.props;
---

<div class:list={["engagement-badge", "gc-status", badge.tone === "pending" ? "gc-status--pending" : "gc-status--reward", `engagement-badge--${badge.tone}`, compact && "engagement-badge--compact"]}>
  <span class="engagement-badge__eyebrow">Badge GoCharbon</span>
  <strong class="engagement-badge__title">{compact ? badge.shortLabel : badge.label}</strong>
  <span class="engagement-badge__score">Score {badge.score}/{badge.maxScore}</span>
</div>

<style>
  .engagement-badge {
    display: inline-flex;
    flex-direction: column;
    gap: var(--engagement-badge-gap);
    padding: var(--engagement-badge-padding);
    border: var(--engagement-badge-border);
    box-shadow: var(--engagement-badge-shadow);
    font-family: var(--tool-qualification-card-font-family);
    background: var(--engagement-badge-bg-default);
    color: var(--engagement-badge-text-color);
  }

  .engagement-badge--compact {
    min-width: 0;
  }

  .engagement-badge--fort {
    background: var(--engagement-badge-bg-fort);
  }

  .engagement-badge--solide {
    background: var(--engagement-badge-bg-solide);
  }

  .engagement-badge--modere {
    background: var(--engagement-badge-bg-modere);
  }

  .engagement-badge--faible {
    background: var(--engagement-badge-bg-faible);
  }

  .engagement-badge--pending {
    background: var(--engagement-badge-bg-pending);
  }

  :global(.dark) .engagement-badge {
    color: var(--engagement-badge-text-color);
  }

  .engagement-badge__eyebrow {
    font-size: var(--engagement-badge-eyebrow-font-size);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: var(--engagement-badge-eyebrow-letter-spacing);
    opacity: 0.75;
  }

  .engagement-badge__title {
    font-size: var(--engagement-badge-title-font-size);
    line-height: var(--engagement-badge-title-line-height);
  }

  .engagement-badge__score {
    font-size: var(--engagement-badge-score-font-size);
    font-weight: 700;
    opacity: 0.8;
  }
</style>
