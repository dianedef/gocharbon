---
import type { ButtonProps } from "../../utils/types/ui";

type Props = ButtonProps;

const {
	href,
	target = "_self",
	variant = 'primary'
} = Astro.props;

const rel = target === "_blank" ? "noopener noreferrer" : undefined;
---

<a
	href={href}
	target={target}
	rel={rel}
	class:list={["gc-action", `gc-action--${variant}`]}
>
	<slot />
</a>
