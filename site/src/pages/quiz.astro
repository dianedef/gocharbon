---
import Layout from "../layouts/Default.astro";
import { ROUTES } from "../config/routes";
---

<Layout
  title="Quiz Business - Rapide ou Avancé | GOCHARBON"
  description="Choisis un format de quiz selon ton niveau d'urgence : une direction rapide pour démarrer ou un diagnostic plus précis pour verrouiller ton premier plan d'action."
  pageTitle="Quiz Business"
>
  <main class="min-h-screen bg-yellow-soft dark:bg-black py-12 md:py-20">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10 md:mb-12">
          <h1 class="text-4xl md:text-5xl font-bold mb-4 poppins text-black dark:text-yellow-soft">
            Choisis Ton Format de Quiz
          </h1>
          <p class="text-lg md:text-xl text-gray-700 dark:text-gray-300">
            Rapide pour avancer aujourd'hui, avancé pour éviter les faux pas cette semaine
          </p>
          <p class="text-base md:text-lg text-gray-700 dark:text-gray-300 max-w-3xl mx-auto mt-4">
            Les deux versions te renvoient vers une direction concrète :
            un type de business à prioriser, un premier parcours, et les premiers gestes pour ne pas perdre une semaine.
          </p>
        </div>

        <div class="quiz-chooser-grid">
          <a href={ROUTES.quizRapide} data-astro-prefetch class="quiz-choice-card gc-card gc-card--interactive">
            <p class="choice-badge">2 minutes</p>
            <h2>Quiz Rapide</h2>
            <p>Tu repars avec un type de business et la première étape du parcours conseillé.</p>
            <span class="choice-cta">Lancer le quiz rapide et passer au premier pas →</span>
          </a>

          <a href={ROUTES.quizAvance} data-astro-prefetch class="quiz-choice-card gc-card gc-card--interactive">
            <p class="choice-badge">~15 minutes</p>
            <h2>Quiz Avancé</h2>
            <p>Tu obtiens une recommandation plus affinée, adaptée à ton profil, ta contrainte de temps et ton niveau réel.</p>
            <span class="choice-cta">Lancer le quiz avancé et cadrer le plan d'action →</span>
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .container {
    max-width: var(--gc-primitive-size-content-wide);
  }

  .quiz-chooser-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gc-primitive-space-5);
  }

  .quiz-choice-card {
    display: block;
    text-decoration: none;
    padding: var(--gc-primitive-space-6);
    color: var(--brand-black);
  }

  .choice-badge {
    display: inline-block;
    font-family: var(--gc-semantic-type-body-family);
    font-weight: 700;
    border: 2px solid var(--brand-black);
    padding: 0.2rem 0.6rem;
    margin: 0 0 0.75rem;
  }

  .quiz-choice-card h2 {
    margin: 0 0 0.75rem;
    font-size: var(--gc-primitive-space-6);
  }

  .quiz-choice-card p {
    margin: 0 0 0.8rem;
    line-height: var(--gc-primitive-font-line-height-body);
  }

  .choice-cta {
    font-weight: 700;
  }

  @media (width <= 768px) {
    .quiz-chooser-grid {
      grid-template-columns: 1fr;
    }
  }

  :global(.dark) .quiz-choice-card {
    color: var(--brand-cream);
  }

  :global(.dark) .choice-badge {
    border-color: var(--brand-cream);
    color: var(--brand-cream);
  }
</style>
