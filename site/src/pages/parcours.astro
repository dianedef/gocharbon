---
import Layout from "../layouts/Default.astro";
import { learningPaths } from "../data/parcoursData";
import { launchSignals } from "../data/launchSignals";
import { filterLaunchParcours, isParcoursOnlyBuild } from "../utils/build-scope";
import {
  CANONICAL_ARCHETYPES,
  getArchetypeDefinition,
  getFeaturedProfilesForArchetype,
} from "../data/profileTaxonomy";
import { getParcoursRoute } from "../config/routes";

const launchBuild = isParcoursOnlyBuild();
const visiblePaths = launchBuild ? filterLaunchParcours(learningPaths) : learningPaths;
const sortedPaths = [...visiblePaths].sort((a, b) => a.profileTitle.localeCompare(b.profileTitle, "fr"));
const categories = [...new Set(sortedPaths.map((path) => path.category))].sort((a, b) => a.localeCompare(b, "fr"));
const familyCards = CANONICAL_ARCHETYPES.map((archetype) => {
  const definition = getArchetypeDefinition(archetype);
  const pivotPath = visiblePaths.find((path) => path.id === definition.pivotProfileSlug);
  if (!pivotPath) return null;

  const examples = getFeaturedProfilesForArchetype(archetype)
    .filter((profile) => !launchBuild || visiblePaths.some((path) => path.id === profile.profileSlug))
    .map((profile) => profile.title);

  return {
    archetype,
    label: definition.label,
    description: definition.description,
    href: getParcoursRoute(pivotPath.id),
    pivotTitle: pivotPath.profileTitle,
    examples,
  };
}).filter((family): family is NonNullable<typeof family> => family != null);

const spotlights = [
  {
    kicker: "Vendre un service",
    path: sortedPaths.find((path) => path.id === "freelance") ?? sortedPaths[0],
    description: "Pour partir d'une compétence, faire une offre simple et aller chercher les premiers clients.",
  },
  {
    kicker: "Construire une audience",
    path: sortedPaths.find((path) => path.id === "content-creator") ?? sortedPaths[1],
    description: "Pour avancer avec du contenu, une audience utile et un système de monétisation cohérent.",
  },
  {
    kicker: "Monter un produit",
    path: sortedPaths.find((path) => path.id === "ecommerce") ?? sortedPaths[2],
    description: "Pour tester un produit, choisir la bonne structure et mieux piloter acquisition et conversion.",
  },
  {
    kicker: "Revenu annexe simple",
    path: sortedPaths.find((path) => path.id === "testeur-utilisateur") ?? sortedPaths[3] ?? sortedPaths[0],
    description: "Pour démarrer avec des tests rémunérés, comprendre vite le terrain et éviter les faux espoirs.",
  },
];
---

<Layout
  title="Parcours Business Pilotes - GOCHARBON"
  description="Choisis parmi les parcours pilotes GoCharbon pour lancer une activité crédible avec un point de départ clair."
  pageTitle="Parcours"
>
  <main class="parcours-shell min-h-screen py-12 md:py-20">
    <div class="container mx-auto px-4 max-w-6xl" data-path-browser>
      <section class="browser-hero bg-yellow-primary dark:bg-yellow-dark">
        <div class="browser-hero-inner">
          <div class="hero-copy">
            <p class="hero-kicker">SÉLECTION DE DÉPART</p>
            <h1 class="hero-title poppins">Choisis un parcours net, pas un faux catalogue</h1>
            <p class="hero-copy-text">
              On a volontairement réduit l’entrée : cinq parcours relus, chacun avec un angle clair, plutôt qu’un catalogue qui fait semblant d’aider tout le monde.
            </p>
          </div>
          <div class="hero-stats">
            <div class="hero-stat">
              <strong>{sortedPaths.length}</strong>
              <span>parcours pilotes</span>
            </div>
            <div class="hero-stat">
              <strong>3 modules</strong>
              <span>bases, spécialisation, exécution</span>
            </div>
            <div class="hero-stat">
              <strong>Plan 7 jours</strong>
              <span>dans chaque parcours</span>
            </div>
          </div>
        </div>
      </section>

      {launchBuild && (
        <section class="families-section bg-white-soft dark:bg-black">
          <div class="section-heading">
            <p class="section-kicker">POURQUOI CETTE SÉLECTION TIENT DEBOUT</p>
            <h2 class="section-title poppins">Ces 5 parcours couvrent les décisions les plus utiles au lancement</h2>
            <p class="section-copy">
              Le lot de départ a été choisi pour une raison simple : chaque modèle correspond à une mécanique économique lisible, avec des pièges concrets et des signaux qu’on peut vraiment suivre.
            </p>
          </div>
          <div class="family-grid">
            {launchSignals.map((signal) => (
              <article class="family-card">
                <p class="family-label">{signal.kicker}</p>
                <h3>{signal.title}</h3>
                <p>{signal.description}</p>
                <div class="source-links" aria-label={`Sources pour ${signal.title}`}>
                  {signal.sources.map((source) => (
                    <a href={source.href} target="_blank" rel="noopener noreferrer">
                      {source.label}
                    </a>
                  ))}
                </div>
                <p class="family-cta-row">
                  <a href={getParcoursRoute(signal.pathId)}>Ouvrir ce parcours →</a>
                </p>
              </article>
            ))}
          </div>
        </section>
      )}

      <section class="spotlight-section bg-white-soft dark:bg-black">
        <div class="section-heading">
          <p class="section-kicker">PORTES D'ENTRÉE</p>
          <h2 class="section-title poppins">Quatre démarrages simples si tu ne sais pas encore quoi ouvrir</h2>
          <p class="section-copy">
            Si tu hésites encore, pars de la logique que tu veux tester : service, audience, produit ou revenu d’appoint.
          </p>
        </div>
        <div class="spotlight-grid">
          {spotlights.map((entry) => (
            <a href={getParcoursRoute(entry.path.id)} class="spotlight-card no-link-style">
              <p class="spotlight-kicker">{entry.kicker}</p>
              <h3>{entry.path.profileTitle}</h3>
              <p>{entry.description}</p>
              <span>Ouvrir ce parcours →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="families-section bg-yellow-soft dark:bg-purple-darker">
        <div class="section-heading">
          <p class="section-kicker">GRANDES FAMILLES</p>
          <h2 class="section-title poppins">Commence par une grande logique, puis ouvre le parcours qui va avec.</h2>
          <p class="section-copy">
            Ce n’est pas une encyclopédie. C’est un point de départ lisible pour choisir sans te noyer dès la première page.
          </p>
        </div>
        <div class="family-grid">
          {familyCards.map((family) => (
            <a href={family.href} class="family-card no-link-style">
              <p class="family-label">{family.label}</p>
              <h3>{family.pivotTitle}</h3>
              <p>{family.description}</p>
              <p class="family-examples">Exemples : {family.examples.join(", ")}</p>
              <span>Explorer cette famille →</span>
            </a>
          ))}
        </div>
      </section>

      <section class="filters-section bg-purple-light dark:bg-purple-dark">
        <div class="section-heading">
          <p class="section-kicker">FILTRES</p>
          <h2 class="section-title poppins">Resserre encore si tu hésites</h2>
          <p class="section-copy">
            Cherche par mot-clé, niveau ou catégorie pour couper le bruit et garder seulement les parcours qui collent à ton point de départ.
          </p>
        </div>
        <div class="filters-toolbar">
            <label class="filter-field">
              <span>Recherche</span>
              <input
                class="w-full"
                id="path-search"
                type="search"
                placeholder="freelance, e-commerce, SEO, contenu..."
                autocomplete="off"
              />
            </label>
            <label class="filter-field">
              <span>Niveau</span>
              <select id="level-filter" class="w-full">
                <option value="all">Tous les niveaux</option>
                <option value="debutant">Débutant</option>
                <option value="intermediaire">Intermédiaire</option>
                <option value="avance">Avancé</option>
              </select>
            </label>
        </div>
        <div class="category-row" aria-label="Filtrer par catégorie">
          <button type="button" class="category-btn active" data-category-filter="all">Tout</button>
          {categories.map((category) => (
            <button type="button" class="category-btn" data-category-filter={category}>
              {category}
            </button>
          ))}
        </div>
        <div class="results-meta flex flex-col md:flex-row items-start md:items-center">
          <p id="results-count">{sortedPaths.length} parcours affichés</p>
          <button type="button" class="reset-btn" id="reset-filters">Réinitialiser</button>
        </div>
      </section>

      <section class="paths-section bg-white-soft dark:bg-black">
        <div class="paths-grid" id="paths-grid">
          {sortedPaths.map((path) => (
            <a
              href={getParcoursRoute(path.id)}
              class="path-card no-link-style"
              data-path-card
              data-title={path.profileTitle}
              data-outcome={path.outcome}
              data-category={path.category}
              data-level={path.level}
            >
              <p class="path-category">{path.category}</p>
              <h2>{path.profileTitle}</h2>
              <p>{path.outcome}</p>
              <div class="path-meta">
                <span>{path.modules.length} modules</span>
                <span>{path.estimatedDuration}</span>
                <span>{path.level}</span>
              </div>
              <span class="path-cta">Voir le parcours →</span>
            </a>
          ))}
        </div>
        <p id="no-results" class="no-results hidden">
          Aucun parcours ne correspond à ce filtre. Essaie un mot-clé plus large ou réinitialise les filtres.
        </p>
      </section>
    </div>
  </main>
</Layout>

<style>
  .parcours-shell {
    background: var(--parcours-shell-bg);
  }

  .browser-hero-inner,
  .hero-stats,
  .spotlight-grid,
  .filters-toolbar,
  .source-links,
  .paths-grid {
    display: grid;
    gap: var(--parcours-grid-gap);
  }

  .browser-hero-inner {
    grid-template-columns: var(--parcours-template-main);
    align-items: stretch;
  }

  .hero-copy,
  .section-heading {
    display: grid;
    gap: var(--parcours-category-gap);
  }

  .hero-kicker,
  .section-kicker,
  .spotlight-kicker {
    margin: 0;
    font-size: var(--parcours-kicker-font-size);
    font-weight: var(--parcours-kicker-font-weight);
    letter-spacing: var(--parcours-kicker-letter-spacing);
    text-transform: uppercase;
    opacity: var(--parcours-kicker-opacity);
  }

  .hero-title,
  .section-title {
    margin: 0;
    line-height: var(--parcours-title-line-height);
  }

  .hero-title {
    font-size: var(--parcours-hero-title-size);
  }

  .hero-copy-text {
    margin: 0;
    font-size: var(--parcours-copy-font-size);
    line-height: var(--parcours-copy-line-height);
    max-width: var(--parcours-copy-max-width);
  }

  .hero-stats {
    grid-template-columns: 1fr;
  }

  .hero-stat,
  .spotlight-card,
  .family-card,
  .filter-field,
  .path-card {
    border: var(--parcours-card-border-width) solid var(--parcours-card-border-color);
    border-radius: var(--parcours-card-border-radius);
    background: var(--parcours-card-bg);
    box-shadow: var(--parcours-card-shadow);
  }

  .hero-stat {
    display: grid;
    gap: var(--parcours-stat-gap);
    padding: var(--parcours-stat-padding);
  }

  .hero-stat strong {
    font-size: var(--parcours-stat-font-size);
    line-height: var(--parcours-stat-line-height);
  }

  .spotlight-grid {
    grid-template-columns: var(--parcours-grid-repeat-3);
  }

  .family-grid {
    display: grid;
    grid-template-columns: var(--parcours-family-grid-columns);
    gap: var(--parcours-grid-gap);
  }

  .spotlight-card,
  .family-card,
  .path-card {
    display: grid;
    gap: var(--parcours-card-inner-gap);
    padding: var(--parcours-card-padding);
  }

  .spotlight-card:hover,
  .family-card:hover,
  .path-card:hover,
  .path-neighbor-card:hover {
    transform: translate(var(--parcours-hover-offset), var(--parcours-hover-offset));
    box-shadow: var(--parcours-shadow-color-muted);
  }

  .path-card:focus-visible,
  .path-card:focus-within {
    outline: var(--parcours-focus-outline-width) solid var(--brand-orange);
    outline-offset: var(--parcours-focus-outline-width);
    box-shadow: var(--parcours-shadow-color-muted);
  }

  .filters-section {
    border: var(--parcours-filters-border);
    background: var(--parcours-filters-bg);
    box-shadow: var(--parcours-filters-shadow);
    margin-bottom: var(--parcours-filters-margin-bottom);
  }

  .spotlight-card h3,
  .family-card h3,
  .path-card h2 {
    margin: 0;
    font-size: var(--parcours-card-title-size);
  }

  .spotlight-card p,
  .family-card p,
  .path-card p {
    margin: 0;
    line-height: var(--parcours-card-body-line-height);
  }

  .spotlight-card span,
  .family-card span,
  .path-cta {
    font-weight: 700;
  }

  .family-label,
  .family-examples {
    font-size: var(--parcours-labels-font-size);
  }

  .source-links {
    grid-template-columns: var(--parcours-source-grid);
    gap: var(--parcours-path-meta-gap);
  }

  .source-links a {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    min-height: var(--parcours-link-min-height);
    padding: var(--parcours-link-padding);
    border: var(--parcours-input-border-width) solid var(--brand-black);
    background: var(--parcours-link-bg);
    color: inherit;
    font-size: var(--parcours-labels-font-size);
    font-weight: 700;
    text-decoration: none;
  }

  .family-cta-row {
    margin: 0;
  }

  .family-cta-row a {
    font-weight: 700;
    color: inherit;
  }

  .filters-toolbar {
    grid-template-columns: var(--parcours-toolbar-template);
    margin-bottom: var(--parcours-toolbar-margin-bottom);
  }

  .filter-field {
    display: grid;
    gap: var(--parcours-field-gap);
    padding: var(--parcours-field-padding);
  }

  .filter-field span {
    font-size: var(--parcours-labels-font-size);
    font-weight: 700;
  }

  .filter-field input,
  .filter-field select {
    min-height: var(--parcours-input-min-height);
    border: var(--parcours-input-border-width) solid var(--brand-black);
    background: var(--parcours-input-bg);
    padding: var(--parcours-input-padding);
    font-family: var(--parcours-font-family);
    font-size: var(--parcours-no-results-font-size);
    color: var(--brand-black);
  }

  .category-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--parcours-category-gap);
    margin-bottom: var(--parcours-toolbar-margin-bottom);
  }

  .category-btn,
  .reset-btn {
    border: var(--parcours-card-border-width) solid var(--parcours-card-border-color);
    background: var(--brand-cream);
    box-shadow: var(--parcours-button-shadow);
    padding: var(--parcours-button-padding);
    font-family: var(--parcours-font-family);
    font-size: var(--parcours-category-font-size);
    font-weight: 700;
    cursor: pointer;
    text-transform: uppercase;
  }

  .category-btn.active {
    background: var(--brand-yellow);
    transform: translate(var(--parcours-active-translate), var(--parcours-active-translate));
    box-shadow: var(--parcours-active-shadow);
  }

  .results-meta {
    display: flex;
    justify-content: space-between;
    gap: var(--parcours-grid-gap);
    align-items: center;
  }

  .results-meta p {
    margin: 0;
    font-weight: 700;
  }

  .paths-grid {
    grid-template-columns: var(--parcours-path-columns);
  }

  .path-category {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: fit-content;
    border: var(--parcours-input-border-width) solid var(--brand-black);
    padding: var(--parcours-path-category-padding);
    font-size: var(--parcours-path-category-font-size);
    font-weight: var(--parcours-kicker-font-weight);
    text-transform: uppercase;
  }

  .path-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--parcours-path-meta-gap);
    font-size: var(--parcours-path-meta-font-size);
    opacity: var(--parcours-path-meta-opacity);
  }

  .path-card.hidden,
  .no-results.hidden {
    display: none;
  }

  .no-results {
    margin: var(--parcours-no-results-margin);
    font-size: var(--parcours-no-results-font-size);
    font-weight: 700;
  }

  :global(.dark) .filters-section {
    border-color: var(--parcours-card-border-color);
    background: var(--parcours-dark-filters-bg);
    box-shadow: var(--parcours-filters-shadow);
  }

  :global(.dark) .hero-stat,
  :global(.dark) .spotlight-card,
  :global(.dark) .family-card,
  :global(.dark) .filter-field,
  :global(.dark) .path-card {
    border-color: var(--parcours-card-border-color);
    background: var(--parcours-dark-card-bg);
    box-shadow: var(--ui-shadow-strong);
  }

  :global(.dark) .source-links a {
    border-color: var(--parcours-card-border-color);
    background: var(--parcours-dark-link-bg);
  }

  :global(.dark) .filter-field input,
  :global(.dark) .filter-field select,
  :global(.dark) .category-btn,
  :global(.dark) .reset-btn,
  :global(.dark) .path-category {
    border-color: var(--parcours-card-border-color);
    background: var(--parcours-dark-link-bg);
    box-shadow: var(--parcours-transparent-bg);
    color: var(--brand-cream);
  }

  :global(.dark) .category-btn.active {
    background: var(--brand-yellow);
    color: var(--brand-black);
    box-shadow: var(--parcours-button-shadow-dark);
  }

  :global(.dark) .spotlight-card:hover,
  :global(.dark) .family-card:hover,
  :global(.dark) .path-card:hover,
  :global(.dark) .path-neighbor-card:hover,
  :global(.dark) .path-card:focus-visible,
  :global(.dark) .path-card:focus-within {
    box-shadow: var(--parcours-hover-shadow);
  }

</style>

<script is:inline>
  function normalizeValue(value) {
    return (value || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function initPathBrowser() {
    const root = document.querySelector("[data-path-browser]");
    if (!root || root.dataset.ready === "true") return;
    root.dataset.ready = "true";

    const searchInput = root.querySelector("#path-search");
    const levelFilter = root.querySelector("#level-filter");
    const resetButton = root.querySelector("#reset-filters");
    const resultCount = root.querySelector("#results-count");
    const noResults = root.querySelector("#no-results");
    const cards = [...root.querySelectorAll("[data-path-card]")];
    const categoryButtons = [...root.querySelectorAll("[data-category-filter]")];

    let activeCategory = "all";

    const applyFilters = () => {
      const query = normalizeValue(searchInput?.value || "");
      const level = levelFilter?.value || "all";
      let visible = 0;

      cards.forEach((card) => {
        const haystack = normalizeValue(
          `${card.dataset.title || ""} ${card.dataset.outcome || ""} ${card.dataset.category || ""}`
        );
        const matchesQuery = !query || haystack.includes(query);
        const matchesLevel = level === "all" || card.dataset.level === level;
        const matchesCategory = activeCategory === "all" || card.dataset.category === activeCategory;
        const shouldShow = matchesQuery && matchesLevel && matchesCategory;

        card.classList.toggle("hidden", !shouldShow);
        if (shouldShow) visible += 1;
      });

      if (resultCount) {
        resultCount.textContent = `${visible} parcours affichés`;
      }

      noResults?.classList.toggle("hidden", visible !== 0);
    };

    searchInput?.addEventListener("input", applyFilters);
    levelFilter?.addEventListener("change", applyFilters);

    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => {
        activeCategory = button.dataset.categoryFilter || "all";
        categoryButtons.forEach((item) => item.classList.toggle("active", item === button));
        applyFilters();
      });
    });

    resetButton?.addEventListener("click", () => {
      activeCategory = "all";
      if (searchInput) searchInput.value = "";
      if (levelFilter) levelFilter.value = "all";
      categoryButtons.forEach((item) => item.classList.toggle("active", item.dataset.categoryFilter === "all"));
      applyFilters();
    });

    applyFilters();
  }

  document.addEventListener("astro:page-load", initPathBrowser);
  document.addEventListener("astro:after-swap", initPathBrowser);
  initPathBrowser();
</script>
