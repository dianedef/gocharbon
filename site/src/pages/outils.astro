---
import { getCollection } from "astro:content";
import Layout from "../layouts/Default.astro";
import PostGrid from "../components/components/PostGrid.astro";
import Button from "../components/components/Button.astro";
import { applyContentScope } from "../utils/content-section";
import { filterBuildVisiblePosts } from "../utils/build-posts";
import {
	buildToolTaxonomyIndex,
	getToolCategoryHref,
	getToolSubcategoryHref,
} from "../utils/tool-taxonomy";
import { ROUTES } from "../config/routes";

const posts = applyContentScope(filterBuildVisiblePosts(await getCollection("posts")), "outils")
	.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
const visiblePosts = posts.slice(0, 30);
const toolCategories = buildToolTaxonomyIndex(posts);
const featuredSubcategories = toolCategories
	.flatMap((category) => category.subcategories.slice(0, 2))
	.sort((a, b) => b.count - a.count)
	.slice(0, 8);
---

<Layout title="Outils pour Entrepreneurs Francophones" description="Sélection d'outils pour entrepreneurs francophones : e-commerce, marketing, SEO, productivité, création. Fiches détaillées avec qualification locale et ancrage économique." pageTitle="La Mine">
	<main class="px-2 md:px-6 py-6 max-w-7xl mx-auto">
		<h1 class="poppins text-3xl md:text-4xl font-bold mb-6 text-black dark:text-white">Outils pour entrepreneurs</h1>
		<section class="mb-8 p-4 md:p-6 border-3 border-black dark:border-yellow-soft bg-white-soft dark:bg-black">
			<h2 class="poppins text-2xl md:text-3xl font-bold mb-3 text-black dark:text-white">Trouver l'outil qui change vraiment ton prochain pas</h2>
			<p class="poppins text-lg mb-4 text-black dark:text-white">
				L'objectif est simple : t'aider à choisir vite le bon outil pour avancer, sans perdre du temps dans des listes infinies.
			</p>
			<p class="poppins text-base md:text-lg mb-4 text-black dark:text-white">
				Chaque fiche t'aide à comparer de façon pragmatique : à quoi sert l'outil, pour quel usage et avec quelles limites.
			</p>
			<p class="poppins text-base md:text-lg mb-4 text-black dark:text-white">
				Tu peux filtrer par catégorie, garder la priorité sur ton besoin, et lire la fiche associée avant de sortir une décision.
			</p>
			<div class="flex flex-wrap gap-3">
				{toolCategories.map((category) => (
					<Button href={getToolCategoryHref(category.slug)} variant="secondary">
						{category.label} ({category.count})
					</Button>
				))}
				<Button href={ROUTES.quiz} variant="secondary">
					J'ai besoin d'orientation
				</Button>
				<Button href={ROUTES.parcours}>
					Recevoir un parcours d'action
				</Button>
				<Button href={ROUTES.methodologie}>
					Notre méthodologie
				</Button>
			</div>
		</section>
		{featuredSubcategories.length > 0 && (
			<section class="mb-8 p-4 md:p-6 border-3 border-black dark:border-yellow-soft bg-yellow-soft dark:bg-black">
				<h2 class="poppins text-2xl md:text-3xl font-bold mb-3 text-black dark:text-white">Sous-catégories utiles</h2>
				<p class="poppins text-base md:text-lg mb-4 text-black dark:text-white">
					Pour les outils, on garde des catégories canoniques et des entrées plus fines seulement quand elles
					aident vraiment à trouver la bonne fiche.
				</p>
				<div class="flex flex-wrap gap-3">
					{featuredSubcategories.map((subcategory) => (
						<Button
							href={getToolSubcategoryHref(subcategory.category, subcategory.slug)}
						>
							{subcategory.label} ({subcategory.count})
						</Button>
					))}
				</div>
			</section>
		)}
		<PostGrid posts={visiblePosts} />
	</main>
</Layout>

<style>
	.page-background {
		transition: background-color 0.3s ease;
	}
</style>
