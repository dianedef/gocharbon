---
import PostSummaryCard from "./PostSummaryCard.astro";
import type { PostGridProps } from "../../utils/types/content";

type Props = PostGridProps;

const {
	posts,
	showLoadingSpinner = false,
	currentPage = 1,
	totalPages = 1,
} = Astro.props;

/* console.log("PostGrid reçoit:", {
	nombreDePosts: posts.length,
	premierPost: posts[0]?.data,
	currentPage,
	totalPages,
}); */
---

<div class="posts mt-8">
	<ul
		class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 posts-container p-4 rounded-lg"
	>
		{
			posts.map((post, index) => (
				<li
					class="post transition-transform hover:scale-[1.02] duration-200"
				>
					<PostSummaryCard post={post} index={index} />
				</li>
			))
		}
	</ul>
	{
		showLoadingSpinner && (
			<div class="flex justify-center mt-8">
				<div class="loading-spinner hidden" />
			</div>
		)
	}
</div>

<style>
	.loading-spinner {
		width: var(--sf-auto-global2-postgrid-width-52ccd25b);
		height: var(--sf-auto-global2-postgrid-height-8c9c9e8d);
		border: 5px solid var(--brand-cream);
		border-top: 5px solid var(--brand-orange);
		border-radius: var(--sf-auto-global2-postgrid-border-radius-2225053d);
		animation: var(--sf-auto-global2-postgrid-animation-18a5f6fb);
	}

	:global(.dark) .loading-spinner {
		border-color: var(--brand-coal);
		border-top-color: var(--brand-yellow);
	}

	@keyframes spin {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	.hidden {
		display: none;
	}
</style>
