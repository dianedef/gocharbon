---
import Layout from "../../layouts/Default.astro";
import { getEntry, render } from "astro:content";
import { learningPaths, learningPathById } from "../../data/parcoursData";
import type { LearningPath } from "../../data/parcoursData";
import { getParcoursIdFromSlug, getParcoursSlug } from "../../data/parcoursSlugs";
import { ROUTES, getParcoursRoute } from "../../config/routes";
import {
  filterLaunchParcours,
  isLaunchBuildPath,
  isLaunchParcoursId,
  isParcoursOnlyBuild,
} from "../../utils/build-scope";
import {
  getArchetypeDefinition,
  getFeaturedProfilesForArchetype,
  getProfileTaxonomy,
  type ProfileSlug,
} from "../../data/profileTaxonomy";
import PathProgressTracker from "../../components/vue/PathProgressTracker.vue";

function markLaunchStepAvailability(path: LearningPath): LearningPath {
  return {
    ...path,
    modules: path.modules.map((module) => ({
      ...module,
      steps: module.steps.map((step) => ({
        ...step,
        availableInBuild: isLaunchBuildPath(step.href),
      })),
    })),
  };
}

export function getStaticPaths() {
  const launchBuild = isParcoursOnlyBuild();
  const visiblePaths = launchBuild ? filterLaunchParcours(learningPaths) : learningPaths;

  return visiblePaths.map((path) => ({
    params: { id: getParcoursSlug(path.id) },
  }));
}

const { id } = Astro.params;
const normalizedId = id?.toLowerCase().trim();
const canonicalId = normalizedId ? getParcoursIdFromSlug(normalizedId) : null;
const pathData = canonicalId
  ? (learningPathById[canonicalId] ??
    learningPaths.find(
      (path) =>
        path.id === normalizedId ||
        path.id === canonicalId ||
        getParcoursSlug(path.id) === normalizedId
    ) ??
    null)
  : null;
const pathEntry = canonicalId ? await getEntry("parcours", canonicalId) : null;
const pathEntryRendered = pathEntry ? await render(pathEntry) : null;
const PathContent = pathEntryRendered?.Content;
const pathMetaDescription = pathEntry?.data.description ??
  (pathData ? `Parcours ${pathData.profileTitle}: les bases, un plan simple et des actions concrètes.` : "Ce parcours est introuvable. Retourne à la liste des parcours.");
const launchBuild = isParcoursOnlyBuild();
const launchVisiblePathData = launchBuild && pathData && !isLaunchParcoursId(pathData.id) ? null : pathData;
const pathDataForTracker = launchVisiblePathData ? markLaunchStepAvailability(launchVisiblePathData) : null;
const levelLabelByValue: Record<string, string> = {
  debutant: "Débutant",
  intermediaire: "Intermédiaire",
  avance: "Avancé",
};
const levelLabel = launchVisiblePathData ? (levelLabelByValue[launchVisiblePathData.level] ?? launchVisiblePathData.level) : "";
const pathTotalSteps = launchVisiblePathData
  ? launchVisiblePathData.modules.reduce((acc, module) => acc + module.steps.length, 0)
  : 0;
const currentProfileSlug = launchVisiblePathData?.profileSlug as ProfileSlug | undefined;
const currentTaxonomy = currentProfileSlug ? getProfileTaxonomy(currentProfileSlug) : null;
const relatedPathIds =
  currentTaxonomy && currentProfileSlug
    ? Array.from(
        new Set([
          ...(currentProfileSlug === getArchetypeDefinition(currentTaxonomy.primaryArchetype).pivotProfileSlug
            ? []
            : [getArchetypeDefinition(currentTaxonomy.primaryArchetype).pivotProfileSlug]),
          ...getFeaturedProfilesForArchetype(currentTaxonomy.primaryArchetype).map((profile) => profile.profileSlug),
        ])
      ).filter((slug) => slug !== currentProfileSlug)
    : [];
const relatedPaths = relatedPathIds
  .map((slug) => learningPathById[slug])
  .filter(Boolean)
  .filter((path) => !launchBuild || isLaunchParcoursId(path.id))
  .slice(0, 4);
const pathReferenceStages = [
  {
    key: "charbon",
    label: "Charbon",
    summary: "Tu poses les bases et clarifies ton point de départ.",
    icon: "/world/charbon.svg",
  },
  {
    key: "mine",
    label: "Mine",
    summary: "Tu creuses ton angle et construis une offre utile.",
    icon: "/world/mine.svg",
  },
  {
    key: "or",
    label: "Or",
    summary: "Tu exécutes vite pour valider avec des actions concrètes.",
    icon: "/world/or.svg",
  },
] as const;
---

<Layout
  title={pathData ? `Parcours ${pathData.profileTitle} | GOCHARBON` : "Parcours introuvable | GOCHARBON"}
  description={pathMetaDescription}
  pageTitle={pathData ? `Parcours ${pathData.profileTitle}` : "Parcours introuvable"}
>
  <main class="parcours-mine-bg min-h-screen py-12 md:py-20">
    <img src="/world/mineurs-fond.svg" alt="" class="mine-bg-illustration" aria-hidden="true" />
    <div class="mine-bg-overlay" aria-hidden="true"></div>
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        {launchVisiblePathData ? (
          <>
            <div class="path-header">
              <div class="path-header-top">
                <p class="path-tag">{launchVisiblePathData.category}</p>
                {!launchBuild && (
                  <a href={`/biz/profils/${launchVisiblePathData.profileSlug}`} class="path-profile-btn no-link-style">Voir le Business</a>
                )}
              </div>
              <h1>{launchVisiblePathData.profileTitle}</h1>
              <p class="path-outcome">{launchVisiblePathData.outcome}</p>
              <div class="path-header-meta">
                <span class="path-meta-card level">
                  <span class="meta-icon" aria-hidden="true">🎯</span>
                  <span class="meta-content">
                    <span class="meta-label">Niveau</span>
                    <strong class="meta-value level-value">{levelLabel}</strong>
                  </span>
                </span>
                <span class="path-meta-card duration">
                  <span class="meta-icon" aria-hidden="true">⏱️</span>
                  <span class="meta-content">
                    <span class="meta-label">Durée</span>
                    <strong class="meta-value">{launchVisiblePathData.estimatedDuration}</strong>
                  </span>
                </span>
              </div>
            </div>

            {PathContent && (
              <div class="path-editorial">
                <div class="path-editorial-lead">
                  <p class="path-editorial-kicker">RÉSUMÉ OPÉRATIONNEL</p>
                  <p class="path-editorial-intro">
                    <strong class="path-editorial-intro-lead">CAP SUR L'EXÉCUTION.</strong> Tu poses le cadre en 30 secondes, puis tu avances avec une <em class="path-editorial-intro-emphasis">cadence simple</em>, <strong class="path-editorial-intro-step">module par module</strong>.
                  </p>
                  <ul class="path-editorial-highlights">
                    <li>
                      <p class="path-editorial-highlight-label">Objectif final</p>
                      <p class="path-editorial-highlight-value"><strong class="path-editorial-value-main">{launchVisiblePathData.outcome}</strong></p>
                    </li>
                    <li>
                      <p class="path-editorial-highlight-label">Niveau et durée</p>
                      <p class="path-editorial-highlight-value"><strong class="path-editorial-value-main">{levelLabel}</strong> <span class="path-editorial-sep" aria-hidden="true">·</span> <em class="path-editorial-value-sub">{launchVisiblePathData.estimatedDuration}</em></p>
                    </li>
                    <li>
                      <p class="path-editorial-highlight-label">Cadence</p>
                      <p class="path-editorial-highlight-value"><strong class="path-editorial-value-main">{launchVisiblePathData.modules.length} MODULES</strong> <span class="path-editorial-sep" aria-hidden="true">·</span> <strong class="path-editorial-value-main">{pathTotalSteps} ÉTAPES</strong> <em class="path-editorial-value-sub">actionnables</em></p>
                    </li>
                  </ul>
                  <div class="path-editorial-cta">
                    <a href="#path-steps" class="path-btn no-link-style">Commencer les étapes</a>
                    <p class="path-editorial-cta-meta"><strong>REPÈRES :</strong> <em>CHARBON -> MINE -> OR</em></p>
                  </div>
                </div>
                <PathContent />
              </div>
            )}

            <section class="path-reference-grid" aria-label="Repères visuels du parcours">
              {launchVisiblePathData.modules.slice(0, 3).map((module, index) => {
                const stage = pathReferenceStages[index] ?? pathReferenceStages[2];
                return (
                  <article class={`path-reference-card ${stage.key}`}>
                    <img src={stage.icon} alt="" class="path-reference-icon" loading="lazy" />
                    <p class="path-reference-stage">Module {index + 1} · {stage.label}</p>
                    <h2 class="path-reference-title">{module.title}</h2>
                    <p class="path-reference-summary">{stage.summary}</p>
                  </article>
                );
              })}
            </section>

            <div id="path-steps" class="path-steps-anchor">
              {pathDataForTracker && <PathProgressTracker client:load pathData={pathDataForTracker} />}
            </div>

            {relatedPaths.length > 0 && (
              <section class="path-neighbors" aria-label="Parcours voisins">
                <div class="path-neighbors-head">
                  <p class="path-neighbors-kicker">AUTRES VOIES DANS LA MÊME FAMILLE</p>
                  <h2>Parcours voisins à explorer ensuite</h2>
                  <p>
                    Tu n'es pas obligé de tout faire. Mais si tu veux comparer deux angles proches dans la même famille business,
                    commence ici.
                  </p>
                </div>
                <div class="path-neighbors-grid">
                  {relatedPaths.map((relatedPath) => (
                    <a href={getParcoursRoute(relatedPath.id)} class="path-neighbor-card no-link-style">
                      <p class="path-neighbor-category">{relatedPath.category}</p>
                      <h3>{relatedPath.profileTitle}</h3>
                      <p>{relatedPath.outcome}</p>
                      <span>Voir ce parcours →</span>
                    </a>
                  ))}
                </div>
              </section>
            )}

            <div class="path-actions">
              <a href={launchBuild ? `${ROUTES.home}#entry-points` : ROUTES.quizAvance} class="path-btn no-link-style">
                {launchBuild ? "Voir les portes d'entrée" : "Refaire le quiz avancé"}
              </a>
              <a href={ROUTES.parcours} class="path-btn secondary no-link-style">Voir tous les parcours</a>
            </div>
          </>
        ) : (
          <div class="path-not-found">
            <h1>Parcours introuvable</h1>
            <p>Le lien utilise probablement un identifiant invalide.</p>
            <a href={ROUTES.parcours} class="path-btn no-link-style">Voir tous les parcours</a>
          </div>
        )}
      </div>
    </div>
  </main>
</Layout>

