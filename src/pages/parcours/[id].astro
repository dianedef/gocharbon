  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-offers) {
    background: var(--sf-auto-id-background-ff9905e0);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-plan) {
    background: var(--sf-auto-id-background-931b41d3);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-tracking) {
    background: var(--sf-auto-id-background-a9abffb8);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-risks) {
    background: var(--sf-auto-id-background-4b845ebb);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-deliverables) {
    background: var(--sf-auto-id-background-3660c0a3);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body > ul > li),
  :global(.dark) .path-editorial :global(.path-editorial-section-body > ol > li) {
    border-bottom-color: var(--sf-auto-id-border-bottom-color-0899f95b);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body > ul > li)::before {
    color: var(--brand-yellow);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body > ol > li)::before {
    border-color: var(--brand-cream);
    background: var(--brand-ink);
    color: var(--brand-yellow);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-plain .path-inline-tag),
  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-offers .path-inline-tag),
  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-plan .path-inline-tag),
  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-tracking .path-inline-tag),
  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-risks .path-inline-tag),
  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-deliverables .path-inline-tag) {
    color: transparent !important;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-plain .path-inline-tag) {
    background-image: var(--sf-auto-id-background-image-120d45b5);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-offers .path-inline-tag),
  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-plan .path-inline-tag) {
    background-image: var(--sf-auto-id-background-image-649fa560);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-tracking .path-inline-tag) {
    background-image: var(--sf-auto-id-background-image-f9e2fb76);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-risks .path-inline-tag) {
    background-image: var(--sf-auto-id-background-image-c6f9bc55);
  }

  :global(.dark) .path-editorial :global(.path-editorial-section-body.path-section-deliverables .path-inline-tag) {
    background-image: var(--sf-auto-id-background-image-4da92db8);
  }

  @media (width <= 720px) {
    .path-editorial {
      padding: var(--sf-auto-id-padding-a3b4937d);
    }

    .path-editorial-lead {
      padding: var(--sf-auto-id-padding-fde4af70);
    }

    .path-editorial-highlights {
      grid-template-columns: 1fr;
    }

    .path-editorial-cta .path-btn {
      width: var(--sf-auto-id-width-76ed12f0);
      text-align: center;
    }
  }
</style>

<script is:inline>
  (() => {
    const SECTION_ORDER = {
      plain: ["var(--sf-auto-id-color-c63fbea5)", "var(--sf-auto-id-color-03f5c77e)", "var(--sf-auto-id-color-d6078da4)"],
      offers: ["var(--sf-auto-id-color-a7f592ff)", "var(--sf-auto-id-color-5c152707)", "var(--sf-auto-id-color-b67d5141)"],
      plan: ["var(--sf-auto-id-color-00fc645e)", "var(--sf-auto-id-color-a6bc958f)", "var(--sf-auto-id-color-bb76978f)"],
      tracking: ["var(--sf-auto-id-color-5ef5b3c2)", "var(--sf-auto-id-color-6c6fef1c)", "var(--sf-auto-id-color-01148a9c)"],
      risks: ["var(--sf-auto-id-color-774151a2)", "var(--sf-auto-id-color-c40254c7)", "var(--sf-auto-id-color-8ae171cc)"],
      deliverables: ["var(--sf-auto-id-color-9a039078)", "var(--sf-auto-id-color-151076ce)", "var(--sf-auto-id-color-8973e5c2)"],
    };
    const PLAIN_TAGS = ["POUR QUI", "OU TROUVER DES CLIENTS", "TON PLUS"];

    const normalizeLabel = (value) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase();

    const compactLabel = (value) =>
      normalizeLabel(value)
        .replace(/[^a-z0-9]+/g, " ")
        .replace(/\s+/g, " ")
        .trim();

    const createLabelNode = (text) => {
      const strong = document.createElement("strong");
      strong.textContent = text.toLocaleUpperCase("fr-FR");
      return strong;
    };

    const createValueNode = (text, useEmphasis) => {
      const node = document.createElement(useEmphasis ? "em" : "span");
      node.textContent = text.trim();
      return node;
    };

    const applyTag = (listItem, sectionType, index) => {
      const palette = SECTION_ORDER[sectionType];
      if (!palette) {
        return;
      }

      const tag = document.createElement("strong");
      tag.className = "path-inline-tag";
      tag.style.color = palette[index % palette.length];
      const rank = index + 1;

      if (sectionType === "offers") tag.textContent = `OFFRE ${rank}`;
      else if (sectionType === "plan") tag.textContent = `JOUR ${rank}`;
      else if (sectionType === "tracking") tag.textContent = `KPI ${rank}`;
      else if (sectionType === "risks") tag.textContent = `RISQUE ${rank}`;
      else if (sectionType === "deliverables") tag.textContent = `LIVRABLE ${rank}`;
      else if (sectionType === "plain") tag.textContent = PLAIN_TAGS[index] ?? `POINT ${rank}`;
      else tag.textContent = `POINT ${rank}`;

      listItem.prepend(tag, document.createTextNode(" "));
    };

    const enhanceListItem = (listItem, sectionType, index) => {
      if (listItem.children.length > 0 || listItem.dataset.enhanced === "1") {
        return;
      }

      const raw = (listItem.textContent || "").trim();
      const dayMatch = raw.match(/^((?:jour|jours)\s*[0-9]+(?:\s*-\s*[0-9]+)?)\s*:\s*(.+)$/i);
      const genericMatch = raw.match(/^([^:]{2,42})\s*:\s*(.+)$/);

      listItem.textContent = "";

      if (dayMatch) {
        const [, , value] = dayMatch;
        const body = createValueNode(value, false);
        listItem.append(body);
        applyTag(listItem, sectionType, index);
        listItem.dataset.enhanced = "1";
        return;
      }

      if (genericMatch) {
        const [, label, value] = genericMatch;
        if (sectionType === "plain") {
          const body = createValueNode(value, true);
          listItem.append(body);
          applyTag(listItem, sectionType, index);
          listItem.dataset.enhanced = "1";
          return;
        }

        const prefix = createLabelNode(`${label}:`);
        const body = createValueNode(
          value,
          sectionType === "deliverables"
        );
        listItem.append(prefix, document.createTextNode(" "), body);
        applyTag(listItem, sectionType, index);
        listItem.dataset.enhanced = "1";
        return;
      }

      if (sectionType === "offers") {
        const text = createValueNode(raw, false);
        listItem.append(text);
      } else if (sectionType === "plan") {
        const text = createValueNode(raw, false);
        listItem.append(text);
      } else {
        const text = createValueNode(raw, false);
        listItem.append(text);
      }

      applyTag(listItem, sectionType, index);
      listItem.dataset.enhanced = "1";
    };

    const enhanceEditorial = () => {
      const headings = document.querySelectorAll(".path-editorial h2");
      headings.forEach((heading) => {
        const label = compactLabel(heading.textContent || "");
        if (label.includes("objectif")) {
          heading.classList.add("path-objective-heading");
        }
        if (label.includes("7 jours") || (label.includes("plan") && label.includes("jour"))) {
          heading.classList.add("path-plan-heading");
        }

        let sectionType = "";
        if (label.includes("en clair")) {
          heading.classList.add("path-plain-heading");
          sectionType = "plain";
        } else if (label.includes("idees d offres")) {
          heading.classList.add("path-offers-heading");
          sectionType = "offers";
        } else if (label.includes("ton plan simple") || label.includes("7 jours")) {
          sectionType = "plan";
        } else if (label.includes("chiffres utiles") || label.includes("a suivre")) {
          heading.classList.add("path-tracking-heading");
          sectionType = "tracking";
        } else if (label.includes("pieges")) {
          heading.classList.add("path-risks-heading");
          sectionType = "risks";
        } else if (label.includes("a la fin")) {
          heading.classList.add("path-deliverables-heading");
          sectionType = "deliverables";
        }

        if (!sectionType) {
          return;
        }

        let body = heading.nextElementSibling;
        if (!body?.classList.contains("path-editorial-section-body")) {
          const container = document.createElement("div");
          container.classList.add("path-editorial-section-body", `path-section-${sectionType}`);
          let cursor = heading.nextElementSibling;

          while (cursor && cursor.tagName !== "H2") {
            const next = cursor.nextElementSibling;
            container.appendChild(cursor);
            cursor = next;
          }

          if (container.childElementCount === 0) {
            return;
          }

          heading.insertAdjacentElement("afterend", container);
          body = container;
        } else {
          body.classList.add(`path-section-${sectionType}`);
        }

        body.querySelectorAll(":scope > ul > li, :scope > ol > li").forEach((item, index) => {
          enhanceListItem(item, sectionType, index);
        });
      });
    };

    enhanceEditorial();
    document.addEventListener("astro:page-load", enhanceEditorial);
  })();
</script>
