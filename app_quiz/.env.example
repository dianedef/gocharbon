# GoCharbon quiz environment template.
# Keep secrets in local or provider-managed environment variables; never commit values.

# Flutter web / Vercel build
API_BASE_URL=https://<backend-host>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_AUTH_REDIRECT_URL=https://<quiz-host>/auth/callback

# Target migration runtime. Keep `legacy` until Firebase and Convex are ready.
GOCHARBON_RUNTIME=legacy
CONVEX_HTTP_URL=https://<deployment>.convex.site
FIREBASE_API_KEY=<firebase-web-api-key>
FIREBASE_APP_ID=<firebase-web-app-id>
FIREBASE_MESSAGING_SENDER_ID=<firebase-sender-id>
FIREBASE_PROJECT_ID=<firebase-project-id>
FIREBASE_AUTH_DOMAIN=<firebase-project-id>.firebaseapp.com
FIREBASE_STORAGE_BUCKET=<firebase-project-id>.firebasestorage.app
FIREBASE_MEASUREMENT_ID=<optional-web-measurement-id>

# FastAPI backend
MONGO_URL=mongodb://<host>:<port>/<database>
DB_NAME=gocharbon_quiz
TRIVIA_ADMIN_KEY=<strong-random-secret>
