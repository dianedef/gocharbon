# GoCharbon quiz environment template.
# Keep secrets in local or provider-managed environment variables; never commit values.

# Flutter web / Vercel build
API_BASE_URL=https://<backend-host>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<supabase-publishable-key>
SUPABASE_AUTH_REDIRECT_URL=https://<quiz-host>/auth/callback

# FastAPI backend
MONGO_URL=mongodb://<host>:<port>/<database>
DB_NAME=gocharbon_quiz
TRIVIA_ADMIN_KEY=<strong-random-secret>
